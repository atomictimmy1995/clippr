# Copy to .env and change what you need. Everything is optional.

# Optional and paid: set this to have Claude pick the moments (about $0.10 or less per hour of
# video). Leave it empty and Clippr uses a free local model (Ollama) or free rules instead.
ANTHROPIC_API_KEY=

# Which picker to use: auto (Claude if key set, else Ollama if running, else rules) | claude | local | rules
# CLIPPR_SELECTOR=auto
# CLIPPR_OLLAMA_URL=http://localhost:11434
# CLIPPR_OLLAMA_MODEL=qwen3:8b

# Transcription (faster-whisper). auto = large-v3-turbo on an NVIDIA GPU, small on CPU.
# CLIPPR_WHISPER_MODEL=auto
# CLIPPR_WHISPER_DEVICE=auto
# CLIPPR_LANGUAGE=            # e.g. en. Empty = detect automatically

# Clips
# CLIPPR_MAX_CLIPS=5
# CLIPPR_CLIP_MIN_S=30
# CLIPPR_CLIP_MAX_S=60

# Download
# CLIPPR_MAX_VIDEO_MIN=180
# CLIPPR_YTDLP_COOKIES=/path/to/cookies.txt   # only if YouTube asks you to sign in

# Storage
# CLIPPR_DATA_DIR=data
# CLIPPR_RETENTION_DAYS=7     # source videos of finished jobs are deleted after this; clips stay
